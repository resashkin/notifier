<?xml version="1.0" encoding="utf-8"?>
<!-- Settings tab: forwarding switch, options, rules, digest, battery, updates. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_settings"
    style="@style/Page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="Forward notifications to Telegram"
            android:textSize="16sp" />

        <TextView
            style="@style/SectionTitle"
            android:paddingTop="12dp"
            android:text="Options" />

        <CheckBox
            android:id="@+id/skip_ongoing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skip ongoing notifications (music, downloads, navigation)" />

        <CheckBox
            android:id="@+id/skip_group_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skip group summaries (&quot;5 new messages&quot;)" />

        <CheckBox
            android:id="@+id/show_app"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show app name in message" />

        <CheckBox
            android:id="@+id/silent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send silently (no Telegram sound)" />

        <!-- Rules -->
        <TextView
            style="@style/SectionTitle"
            android:text="Rules" />

        <TextView
            style="@style/Hint"
            android:text="Always forward beats mute; mute drops, silences or keeps for the digest (the strictest wins); rewrite changes the text (the first match). Also in Telegram: /rules or ⚙️ Settings. Long-press a notification to make a rule from it." />

        <LinearLayout
            android:id="@+id/rules_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <Button
            android:id="@+id/add_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add rule" />

        <!-- Digest -->
        <TextView
            style="@style/SectionTitle"
            android:text="Digest" />

        <TextView
            style="@style/Hint"
            android:text="When notifications a rule sends to the digest arrive together: HH:MM, comma-separated. Empty = off (they wait for /digest)." />

        <EditText
            android:id="@+id/digest_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="09:00, 13:00, 19:00"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions" />

        <TextView
            android:id="@+id/digest_status"
            style="@style/Hint" />

        <!-- Battery -->
        <TextView
            style="@style/SectionTitle"
            android:text="Battery" />

        <Switch
            android:id="@+id/low_battery_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="Warn in Telegram when the battery is low" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <SeekBar
                android:id="@+id/low_battery_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="50"
                android:min="5" />

            <TextView
                android:id="@+id/low_battery_label"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="Sent once per discharge, when the battery drops to this level. The unplugged charger is always reported." />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save" />

        <!-- Updates -->
        <TextView
            style="@style/SectionTitle"
            android:text="Updates" />

        <TextView
            android:id="@+id/update_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/auto_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Install updates automatically" />

        <TextView
            style="@style/Hint"
            android:text="Releases from GitHub (owner/repository)" />

        <EditText
            android:id="@+id/update_repo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions" />

        <Button
            android:id="@+id/allow_install"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow installing updates" />

        <Button
            android:id="@+id/check_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check for updates" />

        <TextView
            style="@style/Hint"
            android:paddingTop="4dp"
            android:text="Checked daily, or send /update to the bot. Android 12+ updates silently; older versions ask you to tap “Update” on the phone." />
    </LinearLayout>
</ScrollView>
